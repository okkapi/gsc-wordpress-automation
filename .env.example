# このファイルを .env にコピーして値を埋めてください。
# .env は .gitignore 済みです。コードに直接書かないこと。

# WordPress REST API
WP_URL=https://example.com
WP_USER=your-wp-username
WP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx   # アプリケーションパスワード

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# 画像素材（任意）
UNSPLASH_ACCESS_KEY=

# X / Twitter API（任意）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
